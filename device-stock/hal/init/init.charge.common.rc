#BSP: jie.hu add for charge start
on boot
        chmod 0664 /sys/class/power_supply/battery/charger.0/stop_charge
        chown system system /sys/class/power_supply/battery/charger.0/stop_charge
	chmod 0664 /sys/class/power_supply/battery/charger.0/transsion_temp_support
	chown system system /sys/class/power_supply/battery/charger.0/transsion_temp_support
	chmod 0664 /sys/class/power_supply/battery/charger.0/transsion_temp_customize
	chown system system /sys/class/power_supply/battery/charger.0/transsion_temp_customize
	chmod 0777 /sys/devices/platform/charger-manager/tran_call_limit
	chown system system /sys/devices/platform/charger-manager/tran_call_limit
	chmod 0777 /sys/devices/platform/charger-manager/CHG_CAPACITY_TEST
	chown system system /sys/devices/platform/charger-manager/CHG_CAPACITY_TEST
#BSP:CHG AICHARGER bigdata jie.hu 20230612 start
	chown system system /sys/devices/platform/charger-manager/tran_aichg_bigdata
	chmod 0666 /sys/devices/platform/charger-manager/tran_aichg_bigdata
	chown system system /sys/devices/platform/charger-manager/tran_aichg_disable_charger
	chmod 0666 /sys/devices/platform/charger-manager/tran_aichg_disable_charger
#BSP:CHG AICHARGER bigdata jie.hu 20230612 end

	chmod 0666 /sys/class/power_supply/tran-auto-test/vbus
	chmod 0666 /sys/class/power_supply/tran-auto-test/ibus
