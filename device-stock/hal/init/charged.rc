service vendor.charged /vendor/bin/charged
   class main
   user root
   group system

#BSP: add for mutilevel charge by lin.xiang start
on property:persist.sys.mutilelvel.charge=2
    write /sys/devices/platform/tran_charger/chgspeed_ctl "1:2"
on property:persist.sys.mutilelvel.charge=3
    write /sys/devices/platform/tran_charger/chgspeed_ctl "1:3"
#BSP: add for mutilevel charge by lin.xiang start
