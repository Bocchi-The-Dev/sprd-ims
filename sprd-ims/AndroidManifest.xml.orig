<?xml version="1.0" encoding="utf-8" standalone="no"?><manifest xmlns:android="http://schemas.android.com/apk/res/android" android:compileSdkVersion="33" android:compileSdkVersionCodename="13" android:sharedUserId="android.uid.phone" coreApp="true" package="com.spreadtrum.ims" platformBuildVersionCode="33" platformBuildVersionName="13">
    <protected-broadcast android:name="com.spreadtrum.ims.VOLTE_REGISTED"/>
    <protected-broadcast android:name="com.spreadtrum.ims.acs.AcsController.ACTION_RETRY"/>
    <permission android:name="com.spreadtrum.ims.permisson.IMS_COMMON" android:protectionLevel="signature"/>
    <uses-permission android:name="android.permission.BROADCAST_STICKY"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="com.spreadtrum.vowifi.permission.ACCESS_CONFIGURATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    <uses-permission android:name="com.spreadtrum.ims.permisson.IMS_COMMON"/>
    <uses-permission android:name="com.spreadtrum.ims.permisson.SRMI_COMMON"/>
    <application android:allowBackup="false" android:defaultToDeviceProtectedStorage="true" android:directBootAware="true" android:extractNativeLibs="true" android:name="ImsApp" android:usesNonSdkApi="true">
        <service android:enabled="true" android:exported="true" android:name=".ImsAdapterService" android:permission="android.permission.BIND_IMS_SERVICE">
            <meta-data android:name="android.telephony.ims.MMTEL_FEATURE" android:value="true"/>
            <meta-data android:name="android.telephony.ims.EMERGENCY_MMTEL_FEATURE" android:value="true"/>
            <intent-filter>
                <action android:name="android.telephony.ims.ImsService"/>
            </intent-filter>
        </service>
        <service android:exported="false" android:name=".IwlanNetworkService" android:permission="android.permission.BIND_TELEPHONY_NETWORK_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.NetworkService"/>
            </intent-filter>
        </service>
        <service android:exported="false" android:name=".IwlanQualifiedNetworksService" android:permission="android.permission.BIND_TELEPHONY_DATA_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.data.QualifiedNetworksService"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.telephony.data.QualifiedNetworksService"/>
                <category android:name="com.unisoc.ims.tests"/>
            </intent-filter>
        </service>
        <service android:exported="false" android:name=".IwlanDataService" android:permission="android.permission.BIND_TELEPHONY_DATA_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.data.DataService"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.telephony.data.DataService"/>
                <category android:name="com.unisoc.ims.tests"/>
            </intent-filter>
        </service>
        <service android:exported="false" android:name=".vowifi.ImsDozeManagerService"/>
        <service android:enabled="true" android:exported="false" android:name=".gba.UnisocGbaService" android:permission="android.permission.BIND_GBA_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.gba.GbaService"/>
            </intent-filter>
        </service>
        <activity android:configChanges="keyboardHidden|orientation|screenSize" android:excludeFromRecents="true" android:name="com.spreadtrum.ims.acs.AcsProvisioningAlertDialog"/>
        <service android:exported="false" android:name="com.spreadtrum.ims.n3am.vowifi.WFCStateMonitorService"/>
        <service android:exported="false" android:name="com.spreadtrum.ims.n3am.vowifi.PhoneStateMonitor"/>
        <service android:exported="false" android:name="com.spreadtrum.ims.n3am.vowifi.RequestResolver"/>
        <service android:exported="false" android:name="com.spreadtrum.ims.n3am.vowifi.VideoStateNotifyService">
            <intent-filter>
                <action android:name="com.android.ims.internal.IN3AMVideoStateNoitfy"/>
            </intent-filter>
        </service>
    </application>
</manifest>